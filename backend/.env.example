PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# DATABASE_URL — choose ONE of the two formats below:
#
# [RECOMMENDED] Supabase Session Pooler (IPv4-compatible, works on all networks)
# Find it in: Supabase Dashboard → Settings → Database → Connection string
# Select "Session mode" (port 5432), NOT "Transaction mode" (port 6543).
# Note: the username contains a dot — URL-encode special characters in the
# password if it contains @, /, :, ?, #, etc. (e.g. replace @ with %40).
#
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# [ALTERNATIVE] Supabase Direct connection (requires IPv6 on your network)
# Host db.PROJECT_REF.supabase.co is IPv6-only. Home routers / VPNs without
# IPv6 will get "connect ETIMEDOUT". Use the pooler URL above instead.
#
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# ---------------------------------------------------------------------------

# Optional: set DB_SSL=true if you use a non-URL DB_HOST that also needs SSL.
# DB_SSL=true

# Optional: override the connection timeout in milliseconds (default: 10000).
# DB_CONNECT_TIMEOUT_MS=10000

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
FRONTEND_ORIGIN=http://localhost:5173
MAX_ACCEPTED_OFFERS_PER_STUDENT=1
GEMINI_API_KEY=
GEMINI_MODEL=
