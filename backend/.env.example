# Backend Environment Variables Template [P2]

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/campus_placement
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=campus_placement

# JWT Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Supabase Auth token verification (use the project URL and publishable/anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
