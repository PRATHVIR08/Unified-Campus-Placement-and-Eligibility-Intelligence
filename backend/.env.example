# Backend Environment Variables Template [P2]
# For Supabase direct connections use the db.<project-ref>.supabase.co host,
# port 5432, and user postgres. For the Transaction Pooler, use its displayed
# host/port and postgres.<project-ref> username. DB_PASSWORD is the raw password.

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/campus_placement
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=campus_placement

# JWT Secret & Expiration (use a long unique value in production)
JWT_SECRET=dev-campus-placement-jwt-secret
JWT_EXPIRES_IN=7d

# Supabase Auth token verification (use the project URL and publishable/anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
